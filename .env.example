# LLM - Kimi (for invoice extraction)
KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# LLM - Llama3 (for chat agent)
LLAMA_API_KEY=your_llama_api_key
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=llama3-8b-8192

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=invoice_db

# App
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=uploads

# JWT Auth
JWT_SECRET_KEY=change_this_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ITERATIONS=390000

# Bootstrap users (optional; used only if user missing in DB)
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change_admin_password
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
AUTH_BOOTSTRAP_COMPTABLE_USERNAME=comptable
AUTH_BOOTSTRAP_COMPTABLE_PASSWORD=change_comptable_password
AUTH_BOOTSTRAP_COMPTABLE_DISPLAY_NAME=Comptable
